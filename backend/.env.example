# FastAPI settings (backend/app/core/config.py).
# Copy this file to backend/.env and fill values locally.
# Start uvicorn from the backend directory so it reads this file.
# Do not commit backend/.env. Blank names keep the defaults in code.

APP_ENV=
HOST=
PORT=
CORS_ALLOWED_ORIGINS=

DATABASE_URL=
ENCRYPTION_MASTER_KEY=

SESSION_COOKIE_NAME=
SESSION_COOKIE_SECURE=
SESSION_TTL_HOURS=
CSRF_SECRET_KEY=

ALLOW_CONTROLLED_LAB_TARGETS=
OUTBOUND_HTTP_TIMEOUT_SECONDS=
OUTBOUND_HTTP_MAX_REDIRECTS=
OUTBOUND_HTTP_MAX_BYTES=
MAX_SCANNER_UPLOAD_MB=

GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROQ_API_KEY=
GEMINI_PRIMARY_MODEL=
GEMINI_ADVANCED_MODEL=
GEMINI_FAST_MODEL=
GEMINI_EMBEDDING_MODEL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=

# Read by backend/app/database/init_db.py on first seed. Not a Settings field.
ADMIN_INITIAL_PASSWORD=
