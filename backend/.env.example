# ==============================================================================
# MYX AI (Windows Edition) — FastAPI Backend Environment Template
# Brand: MYX AI by Midhun Krishnan ("Discover. Detect. Defend.")
# Copy to backend/.env in Google Antigravity and populate real secrets.
# ==============================================================================

APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# PostgreSQL 15+ (Local PostgreSQL, Neon Serverless PostgreSQL, or Supabase PostgreSQL)
# Supports pgvector extension for tenant-isolated RAG embeddings
DATABASE_URL=postgresql+psycopg://myx_admin:CHANGE_ME_STRONG_PASSWORD@localhost:5432/myx_ai_windows

# Master Cryptographic Key (Fernet 32-byte URL-safe base64 key) for encrypting
# stored integration API keys, TOTP secrets, and Windows agent HMAC secrets at rest.
ENCRYPTION_MASTER_KEY=CHANGE_ME_GENERATE_WITH_FERNET_GENERATE_KEY

# Session & CSRF Security
SESSION_COOKIE_NAME=myx_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
CSRF_SECRET_KEY=CHANGE_ME_HIGH_ENTROPY_CSRF_SECRET

# Defensive Assessment & Lab Policies
ALLOW_CONTROLLED_LAB_TARGETS=false
OUTBOUND_HTTP_TIMEOUT_SECONDS=10
OUTBOUND_HTTP_MAX_REDIRECTS=5
OUTBOUND_HTTP_MAX_BYTES=5242880
MAX_SCANNER_UPLOAD_MB=25

# Google Gemini Official SDK (google-genai) — Server-Side Only
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_ADVANCED_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Resend Transactional Email Integration
RESEND_API_KEY=
RESEND_FROM_EMAIL=security-noreply@myx-security.io

# External Threat-Intelligence Integrations (LinkGuard AI)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=

# Secure One-Time Administrator Bootstrap (Outside Source Control)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_this_one_time_bootstrap_secret_123!
